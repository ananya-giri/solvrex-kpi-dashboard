# ==============================================================
#  Git Ignore - Analyst KPI Dashboard (MERN Stack)
# ==============================================================

# Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production Build Outputs
dist/
*/dist/
build/
*/build/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env

# Persistent Database & Backups (Excluded from code tracking)
backend/data/backups/
backend/data/*.json
!backend/data/.gitkeep

# System & OS Files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE & Editor Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Testing & Coverage
coverage/
*/coverage/
.nyc_output/

# Logs
logs/
*.log
